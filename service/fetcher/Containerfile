FROM alpine:3.24

ENV UV_NO_DEV=1 \
    UV_NO_CACHE=1 \
    UV_LOCKED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_PYTHON_INSTALL_DIR=/python

RUN apk add --no-cache ca-certificates tzdata

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

COPY --from=library /students-schedule /app/library/students-schedule
COPY --from=library /utils /app/library/utils
COPY --from=service /fetcher /app/service/fetcher

WORKDIR /app/service/fetcher

RUN uv sync

CMD ["uv", "run", "src/fetcher/main.py"]
